# 复制为根目录 .env 后再按需修改：
# cp .env.docker.example .env
# .env 已被 .gitignore 忽略，不要把真实密钥提交到 Git。

# Docker 内部 MySQL。修改账号、密码或数据库名时，DATABASE_URL 也要同步修改。
MYSQL_USER=city_flash
MYSQL_PASSWORD=city_flash_dev
MYSQL_DATABASE=city_flash
MYSQL_ROOT_PASSWORD=city_flash_root_dev
DATABASE_URL=mysql://city_flash:city_flash_dev@mysql:3306/city_flash

# 本地 Docker 默认使用开发配置，方便先验证容器链路。
# 微信云托管正式部署请按 docs/deploy-wxcloud.md 配置生产值。
NODE_ENV=development
APP_RELEASE_STAGE=testing
PORT=3000
API_PREFIX=api
ENABLE_SWAGGER=true
RUN_MIGRATIONS_ON_STARTUP=false
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
JWT_SECRET=local-only-change-this-secret
AUTH_TOKEN_TTL_SECONDS=604800
CUSTOMER_AUTH_TOKEN_TTL_SECONDS=604800
RIDER_AUTH_TOKEN_TTL_SECONDS=86400
OPERATOR_AUTH_TOKEN_TTL_SECONDS=28800

# 微信登录：本地验证默认使用 Mock；真实环境不要使用 Mock。
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_LOGIN_MOCK_ENABLED=true

RIDER_ORDER_RADIUS_KM=30
RIDER_HEARTBEAT_TIMEOUT_SECONDS=90

# 本地运营后台登录的演示账号。正式环境创建一次运营员后关闭 bootstrap。
OPERATOR_BOOTSTRAP_ENABLED=true
OPERATOR_BOOTSTRAP_USERNAME=admin
OPERATOR_BOOTSTRAP_PASSWORD=DevOperator!2026
OPERATOR_BOOTSTRAP_NAME=同城速送运营员

# 本地支付默认 Mock；正式环境按项目现有生产配置改为 wechat 或 disabled。
WECHAT_PAY_MOCK_ENABLED=true
WECHAT_PAY_MODE=mock
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERT_SERIAL=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_AUTO_RECONCILIATION_ENABLED=false

TENCENT_MAP_KEY=
VITE_TENCENT_MAP_JS_KEY=
BAD_WEATHER_MULTIPLIER=1.15
BAD_WEATHER_OVERRIDE=

# Vite 会把这个值编译进商家后台，必须是浏览器能访问的云托管 API 地址。
VITE_API_BASE_URL=http://127.0.0.1:3000/api

# 可选宿主机端口；数据库不发布宿主机端口。
API_HOST_PORT=3000
MERCHANT_WEB_HOST_PORT=8080

# 可选：更换 MySQL 数据卷名称。
# MYSQL_VOLUME_NAME=city_flash_mysql_data
