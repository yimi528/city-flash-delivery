page { overflow: hidden; background: #f4f0e8; }
.picker-page { position: relative; height: 100vh; overflow: hidden; background: #f4f0e8; }
.map-shell { position: absolute; top: 0; right: 0; left: 0; height: 44vh; overflow: hidden; }
.picker-map { width: 100%; height: 100%; }
.map-nav { position: absolute; left: 24rpx; right: 24rpx; height: 76rpx; display: flex; align-items: center; justify-content: space-between; }
.back, .nav-space { width: 76rpx; height: 76rpx; }
.back { border-radius: 38rpx; background: rgba(255, 253, 248, .94); color: #18201d; font-size: 58rpx; line-height: 68rpx; text-align: center; box-shadow: 0 10rpx 30rpx rgba(48, 39, 27, .16); }
.nav-title { height: 64rpx; padding: 0 24rpx; border-radius: 32rpx; color: #18201d; background: rgba(255, 253, 248, .92); box-shadow: 0 10rpx 30rpx rgba(48, 39, 27, .12); font-size: 26rpx; font-weight: 900; line-height: 64rpx; }
.center-pin { position: absolute; z-index: 8; top: 50%; left: 50%; width: 80rpx; height: 120rpx; margin-top: -111rpx; margin-left: -66rpx; }
.center-pin.moving { margin-top: -117rpx; }
.map-tip { position: absolute; top: 164rpx; left: 50%; padding: 11rpx 18rpx; border-radius: 22rpx; color: #58645d; background: rgba(255, 253, 248, .88); font-size: 20rpx; transform: translateX(-50%); box-shadow: 0 8rpx 22rpx rgba(48, 39, 27, .1); white-space: nowrap; }
.locate-button { position: absolute; right: 24rpx; bottom: 24rpx; height: 68rpx; padding: 0 20rpx; border-radius: 34rpx; background: rgba(255, 253, 248, .94); display: flex; align-items: center; box-shadow: 0 10rpx 30rpx rgba(48, 39, 27, .16); }
.locate-glyph { color: #bd4934; font-size: 31rpx; font-weight: 900; }
.locate-text { margin-left: 8rpx; color: #26332f; font-size: 22rpx; font-weight: 900; }
.result-panel { position: absolute; z-index: 10; right: 0; bottom: 0; left: 0; height: 56vh; padding: 14rpx 30rpx calc(160rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: rgba(255, 253, 248, .98); box-shadow: 0 -16rpx 46rpx rgba(48, 39, 27, .18); box-sizing: border-box; }
.drag-handle { width: 72rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 8rpx; background: #d8d5cc; }
.panel-head { padding: 0 2rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; }
.panel-kicker { color: #bd4934; font-size: 19rpx; font-weight: 900; letter-spacing: 1.5rpx; }
.panel-title { margin-top: 5rpx; color: #18201d; font-size: 30rpx; font-weight: 900; }
.panel-status { padding: 7rpx 12rpx; border-radius: 18rpx; color: #28745c; background: #e8f2eb; font-size: 19rpx; font-weight: 900; }
.status-dot { margin-right: 5rpx; font-size: 13rpx; }
.panel-status.pending { color: #a17439; background: #f8efdc; }
.selected-place { margin-top: 16rpx; padding: 15rpx 18rpx; border: 2rpx solid #eae5db; border-radius: 20rpx; display: flex; align-items: center; gap: 14rpx; background: #faf7f0; }
.result-pin { width: 48rpx; height: 48rpx; flex: 0 0 auto; border-radius: 15rpx; color: #fff; background: #d95739; font-size: 22rpx; font-weight: 900; line-height: 48rpx; text-align: center; }
.result-copy { min-width: 0; flex: 1; }
.result-name { overflow: hidden; color: #26332f; font-size: 25rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.result-name.muted { color: #8e948b; }
.result-detail { margin-top: 5rpx; overflow: hidden; color: #8b9188; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.error-message { margin-top: 12rpx; padding: 12rpx 16rpx; border-radius: 14rpx; color: #b7372a; background: #fff0ed; font-size: 20rpx; font-weight: 800; }
.form-card { margin-top: 14rpx; padding: 0 20rpx; border: 2rpx solid #ebe6dc; border-radius: 22rpx; background: #fffdf8; }
.field-row { min-height: 78rpx; border-bottom: 2rpx solid #f0ece4; display: flex; align-items: center; gap: 16rpx; }
.field-label { width: 108rpx; flex: 0 0 auto; color: #35413c; font-size: 23rpx; font-weight: 900; }
.field-label text { color: #c44934; }
.field-label .optional { margin-left: 5rpx; color: #a2a49a; font-size: 18rpx; font-weight: 500; }
.field-value { min-width: 0; flex: 1; overflow: hidden; color: #26332f; font-size: 23rpx; font-weight: 800; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.field-input { min-width: 0; height: 66rpx; flex: 1; color: #26332f; font-size: 23rpx; text-align: right; }
.field-input::placeholder { color: #b1b2a9; font-size: 21rpx; }
.tag-section { padding: 17rpx 0 14rpx; border-bottom: 2rpx solid #f0ece4; display: flex; align-items: center; gap: 16rpx; }
.tags { min-width: 0; flex: 1; display: flex; gap: 10rpx; overflow: hidden; }
.tag { min-width: 52rpx; height: 40rpx; padding: 0 12rpx; border: 2rpx solid #e7e3da; border-radius: 20rpx; color: #7b837b; background: #faf8f2; display: flex; align-items: center; justify-content: center; font-size: 19rpx; white-space: nowrap; }
.tag.active { border-color: #d95739; color: #bd4934; background: #fbece7; font-weight: 900; }
.default-row { min-height: 74rpx; display: flex; align-items: center; gap: 12rpx; }
.check { width: 36rpx; height: 36rpx; flex: 0 0 auto; border: 2rpx solid #c9cec7; border-radius: 50%; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 21rpx; font-weight: 900; }
.check.on { border-color: #28745c; background: #28745c; }
.default-copy, .save-copy { min-width: 0; flex: 1; }
.default-title, .save-title { color: #35413c; font-size: 22rpx; font-weight: 900; }
.default-sub, .save-sub { margin-top: 3rpx; color: #9a9d94; font-size: 18rpx; }
.smart-card { margin-top: 14rpx; padding: 16rpx; border: 2rpx solid #e4e9e2; border-radius: 20rpx; background: #f7faf5; }
.smart-head { display: flex; align-items: center; gap: 10rpx; }
.smart-mini { width: 36rpx; height: 36rpx; flex: 0 0 auto; border-radius: 12rpx; color: #fff; background: #28745c; display: flex; align-items: center; justify-content: center; font-size: 21rpx; }
.smart-copy { min-width: 0; flex: 1; }
.smart-title { color: #35413c; font-size: 22rpx; font-weight: 900; }
.smart-sub { margin-top: 3rpx; overflow: hidden; color: #9a9d94; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.smart-badge { padding: 5rpx 9rpx; border-radius: 16rpx; color: #28745c; background: #e8f2eb; font-size: 15rpx; font-weight: 900; letter-spacing: 1rpx; }
.smart-input-row { margin-top: 12rpx; padding-top: 12rpx; border-top: 2rpx solid #e6eee6; display: flex; align-items: flex-end; gap: 10rpx; }
.smart-input-wrap { min-width: 0; min-height: 86rpx; flex: 1; padding: 10rpx 12rpx 7rpx; border: 2rpx solid #e1e9df; border-radius: 15rpx; background: #fffdf8; }
.smart-input { width: 100%; min-height: 48rpx; max-height: 94rpx; color: #35413c; font-size: 21rpx; line-height: 1.4; }
.smart-input::placeholder { color: #aaa9a0; }
.smart-input-note { margin-top: 4rpx; color: #9ca99e; font-size: 16rpx; }
.smart-action { width: 92rpx; height: 54rpx; flex: 0 0 auto; margin: 0; padding: 0; border: 0; border-radius: 27rpx; color: #fffdf8; background: #d95739; font-size: 20rpx; font-weight: 900; line-height: 54rpx; text-align: center; box-shadow: 0 8rpx 16rpx rgba(185, 47, 32, .16); }
.smart-action::after { border: 0; }
.smart-result { margin-top: 8rpx; color: #28745c; font-size: 18rpx; }
.result-check { display: inline-flex; width: 24rpx; height: 24rpx; margin-right: 5rpx; border-radius: 50%; color: #fff; background: #28745c; align-items: center; justify-content: center; font-size: 15rpx; }
.confirm-dock { position: absolute; z-index: 12; right: 0; bottom: 0; left: 0; padding: 10rpx 30rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid rgba(24, 32, 29, .08); background: rgba(255, 253, 248, .94); box-shadow: 0 -10rpx 28rpx rgba(48, 39, 27, .08); backdrop-filter: blur(18rpx); }
.confirm-button { height: 76rpx; margin: 5rpx 0 0; border-radius: 40rpx; color: #fffdf8; background: linear-gradient(110deg, #d95739, #bd3425); font-size: 27rpx; font-weight: 900; line-height: 76rpx; box-shadow: 0 12rpx 24rpx rgba(185, 47, 32, .2); }
.confirm-button::after { border: 0; }
.confirm-button[disabled] { color: #fff; background: #d3d5cf; box-shadow: none; }
.panel-safe-note { margin-top: 0; color: #a2a49a; font-size: 17rpx; text-align: center; }
.back:active, .locate-button:active, .smart-card:active, .save-address-row:active, .confirm-button:active { transform: scale(.97); opacity: .84; }

/* Smart fill + save preference: make state and next action visible at a glance. */
.smart-card {
  border-color: #dce9df;
  background: linear-gradient(145deg, #f6fbf7, #eef7f0);
  box-shadow: none;
  transition: border-color 160ms ease, background-color 160ms ease;
}

.smart-card.is-recognizing { border-color: #a7d6b8; background: #edf9f1; }
.smart-head { align-items: flex-start; }
.smart-mini { background: #28745c; }
.smart-badge { color: #28745c; background: #e2f3e7; }
.smart-input-row { border-top: 0; padding-top: 0; align-items: flex-end; }
.smart-input-wrap { background: #fffdf8; border-color: #d8e7dc; }
.smart-input-wrap.has-text { border-color: #9dceb0; background: #fff; }
.smart-input-meta { margin-top: 8rpx; display: flex; justify-content: space-between; gap: 10rpx; color: #94a198; font-size: 17rpx; }
.smart-input-meta text:last-child { color: #28745c; font-weight: 800; }
.smart-action { width: 116rpx; height: 60rpx; border-radius: 30rpx; background: #b9c9bd; box-shadow: none; font-size: 21rpx; }
.smart-action.ready { background: #d95739; box-shadow: 0 10rpx 20rpx rgba(185, 47, 32, .16); }
.smart-action[disabled] { color: #fff; background: #91b59d; opacity: .88; }
.smart-action-arrow { margin-left: 5rpx; font-size: 25rpx; }
.smart-result.success, .smart-result.warning { margin-top: 14rpx; padding: 14rpx; border-radius: 16rpx; display: flex; align-items: center; gap: 10rpx; color: #28745c; background: rgba(255, 255, 255, .72); }
.smart-result.warning { color: #94601a; background: #fff8e8; }
.smart-result-icon { width: 34rpx; height: 34rpx; flex: 0 0 auto; border-radius: 50%; color: #fff; background: #28745c; display: flex; align-items: center; justify-content: center; font-size: 21rpx; font-weight: 900; }
.smart-result-copy { min-width: 0; flex: 1; }
.smart-preview-title { color: #28745c; font-size: 21rpx; font-weight: 900; }
.smart-result.warning .smart-preview-title { color: #94601a; }
.smart-preview-sub { margin-top: 3rpx; color: #78867d; font-size: 18rpx; line-height: 1.35; }
.save-address-row { min-height: 104rpx; margin-top: 14rpx; padding: 16rpx 18rpx; border: 2rpx solid #e5e7df; border-radius: 20rpx; display: flex; align-items: center; gap: 12rpx; background: rgba(255, 253, 248, .92); transition: border-color 160ms ease, background-color 160ms ease; }
.save-address-row.is-selected { border-color: #9dceb0; background: #eff9f1; }
.save-option-icon { width: 42rpx; height: 42rpx; flex: 0 0 auto; border-radius: 14rpx; color: #819087; background: #eef1eb; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 900; }
.save-address-row.is-selected .save-option-icon { color: #fff; background: #28745c; }
.save-copy { min-width: 0; flex: 1; }
.save-title { color: #35413c; font-size: 22rpx; font-weight: 900; }
.save-sub { margin-top: 4rpx; color: #8f9990; font-size: 18rpx; line-height: 1.3; }
.save-toggle { width: 72rpx; height: 40rpx; flex: 0 0 auto; padding: 4rpx; border-radius: 24rpx; background: #d5d9d1; box-sizing: border-box; transition: background-color 160ms ease; }
.save-toggle-thumb { width: 32rpx; height: 32rpx; border-radius: 50%; background: #fff; box-shadow: 0 3rpx 8rpx rgba(48, 60, 49, .18); transition: transform 160ms ease; }
.save-address-row.is-selected .save-toggle { background: #28745c; }
.save-address-row.is-selected .save-toggle-thumb { transform: translateX(32rpx); }

@media (prefers-reduced-motion: reduce) {
  .smart-card, .save-address-row, .smart-action, .save-toggle, .save-toggle-thumb { transition: none; }
}

/* Give the pasted content the space; keep recognition as a compact commit action. */
.smart-input-row { align-items: stretch; }
.smart-input-wrap { height: 146rpx; min-height: 146rpx; padding: 14rpx 16rpx 9rpx; box-sizing: border-box; }
.smart-input { display: block; height: 86rpx; min-height: 86rpx; max-height: 86rpx; }
.smart-action { width: 76rpx; min-width: 76rpx; flex: 0 0 76rpx; height: 52rpx; align-self: flex-end; padding: 0 5rpx; border-radius: 26rpx; }
.smart-action-arrow { font-size: 21rpx; }
.smart-action:active { transform: scale(.95); opacity: .86; }
.smart-head-action { width: 88rpx; min-width: 88rpx; height: 50rpx; flex: 0 0 88rpx; margin: 0; padding: 0 6rpx; border: 0; border-radius: 25rpx; color: #fffdf8; background: #b9c9bd; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 900; box-shadow: none; }
.smart-head-action.ready { background: #d95739; box-shadow: 0 8rpx 16rpx rgba(185, 47, 32, .14); }
.smart-head-action[disabled] { color: #fff; background: #91b59d; opacity: .9; }
