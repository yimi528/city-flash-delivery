<view class="confirm-page">
  <view style="height: {{statusBarHeight}}px"></view>
  <view class="page-nav">
    <view class="back floating-back" style="top: {{statusBarHeight + 12}}px;" bindtap="goBack" role="button" aria-label="返回">‹</view>
    <view class="nav-action-placeholder floating-back-spacer"></view>
    <view class="nav-title">{{draft.taskId === 'moving_handling' ? '搬运装卸' : '确认订单'}}</view>
    <view class="nav-action">明细</view>
  </view>

  <view class="handling-intro" wx:if="{{draft.taskId === 'moving_handling'}}">
    <view class="handling-kicker">一站式搬运</view>
    <view class="handling-title">搬运装卸统一下单</view>
    <view class="handling-sub">填写上门服务地址，商家接单后安排骑手到场</view>
  </view>

  <view class="card handling-card" wx:if="{{draft.taskId === 'moving_handling'}}">
    <view class="section-head handling-head">
      <view>
        <view class="section-title">搬运装卸服务</view>
        <view class="handling-hint">填写现场情况，工作人员按需求安排</view>
      </view>
    </view>
    <view class="handling-options">
      <block wx:for="{{handlingTypes}}" wx:key="name">
        <view wx:if="{{item.phone}}" class="handling-option phone-only" data-phone="{{item.phone}}" bindtap="callHandlingPhone">
          <view class="handling-icon">{{item.icon}}</view>
          <view class="handling-copy">
            <view class="handling-name">{{item.name}}</view>
            <view class="handling-desc">{{item.desc}}</view>
            <view class="handling-phone">电话预约 {{item.phone}}</view>
          </view>
          <view class="handling-check phone-label">预约</view>
        </view>
        <view wx:else class="handling-option {{selectedItem === item.name ? 'active' : ''}}" data-item="{{item.name}}" bindtap="selectItem">
          <view class="handling-icon">{{item.icon}}</view>
          <view class="handling-copy">
            <view class="handling-name">{{item.name}}</view>
            <view class="handling-desc">{{item.desc}}</view>
          </view>
          <view class="handling-check">{{selectedItem === item.name ? '✓' : ''}}</view>
        </view>
      </block>
    </view>
    <textarea class="handling-remark" value="{{draft.remark}}" placeholder="{{fieldConfig.remarkPlaceholder}}" auto-height maxlength="160" bindinput="inputRemark" />
  </view>

  <view class="route-address-card card">
    <view class="service-badge" wx:if="{{draft.service === '帮买'}}">帮买 · 商品价格 ￥{{estimate.productFee}}</view>
    <view class="service-badge" wx:else>{{draft.service}} · 预计 {{estimate.distance}}km</view>
    <view class="route-meter" wx:if="{{draft.taskId !== 'moving_handling'}}">{{isRouteLoading ? '正在获取腾讯地图距离...' : routeSource}} · {{routeDuration ? '约 ' + routeDuration + ' 分钟' : '预计 ' + estimate.distance + 'km'}}</view>
    <view class="line-section" wx:if="{{taskLines.length || requiresLine}}">
      <view class="section-head line-section-head">
        <view>
          <view class="step-label">01</view>
          <view class="section-title">选择线路</view>
        </view>
        <view class="muted">{{draft.taskId === 'carpool_ride' ? '单人票价' : (draft.taskId === 'send_parcel' ? '按物品和重量' : '固定价格')}}</view>
      </view>
      <view class="line-helper" wx:if="{{requiresLine && !selectedLineId}}">先选定目的地线路，再填写发货与收货地址</view>
      <view class="direction-switch" wx:if="{{draft.taskId === 'carpool_ride'}}">
        <view class="direction-option {{draft.direction !== 'RETURN' ? 'active' : ''}}" data-direction="OUTBOUND" bindtap="selectDirection">去程 · 福鼎出发</view>
        <view class="direction-option {{draft.direction === 'RETURN' ? 'active' : ''}}" data-direction="RETURN" bindtap="selectDirection">返程 · 回福鼎</view>
      </view>
      <view class="route-cascader" wx:if="{{taskLines.length}}">
        <view class="cascader-column cascader-parent-column">
          <view class="cascader-column-label">目的地线路</view>
          <block wx:for="{{taskLines}}" wx:key="id">
            <view class="cascader-option {{selectedLineId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectLine">
              <view class="cascader-option-copy">
                <view class="line-name">{{item.name}}</view>
                <view class="cascader-option-meta">{{item.originName || '福鼎'}} 出发</view>
              </view>
              <view class="cascader-arrow">›</view>
            </view>
          </block>
        </view>
        <view class="cascader-column cascader-child-column {{selectedLineId ? '' : 'is-disabled'}}">
          <view class="cascader-column-label">线路信息</view>
          <view class="cascader-line-preview {{selectedLineId ? '' : 'is-disabled'}}">
            <view class="cascader-child-title">{{selectedLineId ? (draft.selectedLine.name + '线路') : '请选择左侧线路'}}</view>
            <view class="cascader-child-sub" wx:if="{{selectedLineId}}">{{draft.selectedLine.originName || '福鼎'}} 出发 · {{draft.selectedLine.pending ? '价格待定' : (draft.selectedLine.priceUnit === 'PER_PERSON' ? '￥' + draft.selectedLine.price + '/人' : '￥' + draft.selectedLine.price)}}</view>
            <view class="cascader-child-sub" wx:else>选择后可继续填写地址</view>
          </view>
        </view>
      </view>
      <view class="line-empty" wx:if="{{requiresLine && !taskLines.length}}">线路正在加载，请稍候</view>
    </view>

    <view class="route-divider" wx:if="{{draft.taskId !== 'moving_handling'}}"></view>

    <view class="address-section {{addressLocked ? 'is-locked' : ''}}">
      <view class="section-head address-section-head">
        <view>
          <view class="step-label">{{requiresLine ? '02' : '01'}}</view>
          <view class="section-title">{{draft.taskId === 'moving_handling' ? '填写发货地址' : '填写地址'}}</view>
        </view>
        <view class="muted">{{addressLocked ? '选择线路后可填写' : (draft.taskId === 'moving_handling' ? '骑手到该地址上门服务' : '选择发货与收货地址')}}</view>
      </view>
      <view class="address-cascader {{addressLocked ? 'is-disabled' : ''}}">
        <view class="cascader-column cascader-address-parent">
          <view class="cascader-column-label">地址类型</view>
          <view class="address-cascader-parent {{addressLocked ? 'is-disabled' : (draft.pickup ? 'active' : '')}}">
            <view class="cascader-child-dot {{draft.service === '帮买' ? 'tag-buy' : 'tag-red'}}">{{draft.service === '帮买' ? '买' : '发'}}</view>
            <view>{{draft.service === '帮买' ? '购买地址' : '发货地址'}}</view>
          </view>
          <view class="address-cascader-parent {{addressLocked ? 'is-disabled' : (draft.dropoff ? 'active' : '')}}" wx:if="{{draft.taskId !== 'moving_handling'}}">
            <view class="cascader-child-dot tag-green">收</view>
            <view>收货地址</view>
          </view>
        </view>
        <view class="cascader-column cascader-address-child {{addressLocked ? 'is-disabled' : ''}}">
          <view class="cascader-column-label">地址详情</view>
          <view class="address-cascader-child {{addressLocked ? 'is-disabled' : ''}}" data-type="{{draft.service === '帮买' ? 'purchase' : 'pickup'}}" bindtap="chooseRouteAddress">
            <view class="cascader-child-copy">
              <view class="cascader-child-title">{{draft.pickup ? draft.pickup.name : (draft.service === '帮买' ? '请选择购买地址' : '请选择发货地址')}}</view>
              <view class="cascader-child-sub" wx:if="{{draft.pickup}}">{{draft.pickup.detail}}</view>
              <view class="cascader-child-sub" wx:else>{{addressLocked ? '请先选择上方线路' : '点击选择地址'}}</view>
            </view>
            <view class="cascader-arrow">›</view>
          </view>
          <view class="address-cascader-child {{addressLocked ? 'is-disabled' : ''}}" wx:if="{{draft.taskId !== 'moving_handling'}}" data-type="dropoff" bindtap="chooseRouteAddress">
            <view class="cascader-child-copy">
              <view class="cascader-child-title">{{draft.dropoff ? draft.dropoff.name : '请选择收货地址'}}</view>
              <view class="cascader-child-sub" wx:if="{{draft.dropoff}}">{{draft.dropoff.detail}}</view>
              <view class="cascader-child-sub" wx:else>{{addressLocked ? '请先选择上方线路' : '点击选择地址'}}</view>
            </view>
            <view class="cascader-arrow">›</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="card passenger-card" wx:if="{{draft.taskId === 'carpool_ride'}}">
    <view>
      <view class="section-title">乘车人数</view>
        <view class="muted">小车，最多6名乘客</view>
    </view>
    <view class="passenger-stepper">
      <button data-step="-1" bindtap="changePassenger" disabled="{{passengerCount <= 1}}">−</button>
      <text>{{passengerCount}} 人</text>
      <button data-step="1" bindtap="changePassenger" disabled="{{passengerCount >= 6}}">＋</button>
    </view>
  </view>

  <view class="card buy-card" wx:if="{{draft.service === '帮买'}}">
    <view class="section-head">
      <view class="section-title">代买商品</view>
      <view class="muted">骑手按描述购买</view>
    </view>
    <textarea value="{{draft.buyItems}}" placeholder="请填写品牌、口味、规格、可接受替代方案" auto-height maxlength="120" bindinput="inputBuyItems" />
    <view class="buy-budget-row">
      <view>
        <view class="buy-budget-title">商品价格</view>
        <view class="buy-budget-sub">按预计购买金额计入本次应付合计</view>
      </view>
      <view class="buy-budget-input"><text>￥</text><input type="digit" value="{{draft.budget}}" bindinput="inputBudget" /></view>
    </view>
  </view>

  <view class="card option-card" wx:if="{{draft.service !== '帮买' && draft.taskId !== 'moving_handling' && draft.taskId !== 'carpool_ride'}}">
    <view class="section-head">
      <view class="section-title">{{fieldConfig.sectionTitle}}</view>
      <view class="muted">{{fieldConfig.sectionHint}}</view>
    </view>
    <view class="limit-banner" wx:if="{{fieldConfig.limitText}}">{{fieldConfig.limitText}}</view>
    <view class="chips">
      <block wx:for="{{itemTypes}}" wx:key="*this">
        <view class="chip {{selectedItem === item ? 'active' : ''}}" data-item="{{item}}" bindtap="selectItem">{{item}}</view>
      </block>
    </view>
    <view class="weight-row" wx:if="{{fieldConfig.showWeight && !(draft.taskId === 'send_parcel' && selectedItem === '宠物')}}">
      <text>重量</text>
      <view class="weight-list">
        <block wx:for="{{weights}}" wx:key="*this">
          <view class="weight {{selectedWeight === item ? 'active' : ''}}" data-weight="{{item}}" bindtap="selectWeight">{{item}}{{draft.taskId === 'send_parcel' ? 'kg内' : 'kg'}}</view>
        </block>
      </view>
    </view>
    <textarea placeholder="{{fieldConfig.remarkPlaceholder}}" auto-height maxlength="120" bindinput="inputRemark" />
  </view>

  <view class="card cargo-card">
    <view class="section-head">
      <view class="section-title">固定服务车型</view>
      <view class="muted">下单后不可切换</view>
    </view>
    <view class="cargo-summary">
      <view class="cargo-emoji">{{draft.cargoOptions.icon}}</view>
      <view class="cargo-info">
        <view class="cargo-name">{{draft.cargoOptions.vehicleName}}</view>
        <view class="cargo-desc">
          <text>{{draft.cargoOptions.categoryName}}</text>
          <text wx:if="{{draft.taskId === 'moving_handling'}}"> · 按服务类型固定</text>
          <text wx:elif="{{draft.service !== '帮买' && draft.item !== '宠物'}}"> · {{draft.cargoOptions.weightLabel}}</text>
          <text> · {{draft.cargoOptions.vehicleCapacity}}</text>
        </view>
      </view>
      <view class="cargo-fee" wx:if="{{draft.cargoOptions.vehicleFee}}">+￥{{draft.cargoOptions.vehicleFee}}</view>
      <view class="cargo-fee" wx:else>基础</view>
    </view>
  </view>

  <view class="card price-card">
    <view class="section-head">
      <view class="section-title">费用预估</view>
      <view class="arrival">{{estimate.pricingNote}}</view>
    </view>
    <view class="price-row" wx:if="{{draft.service !== '帮买'}}"><text>{{estimate.baseTitle}}</text><text>{{estimate.baseText}}</text></view>
    <view class="price-row" wx:if="{{draft.service !== '帮买' && estimate.showDistanceFee}}"><text>{{estimate.distanceFeeTitle}}</text><text>￥{{estimate.distanceFee}}</text></view>
    <view class="price-row" wx:if="{{draft.service !== '帮买' && estimate.showWeatherFee}}"><text>恶劣天气加价</text><text>￥{{estimate.weatherFee}}</text></view>
    <view class="price-row" wx:if="{{estimate.showWeightFee}}"><text>重量费</text><text>￥{{estimate.weightFee}}</text></view>
    <view class="price-row" wx:if="{{estimate.showVehicleFee}}"><text>车型费</text><text>￥{{estimate.vehicleFee}}</text></view>
    <view class="price-row" wx:if="{{estimate.showUrgentFee}}"><text>急送费</text><text>￥{{estimate.urgentFee}}</text></view>
    <view class="price-row discount" wx:if="{{estimate.showDiscount}}"><text>{{estimate.discountTitle}}</text><text>-￥{{estimate.discount}}</text></view>
    <view class="price-row budget-fee" wx:if="{{draft.service === '帮买'}}"><text>商品价格</text><text>￥{{estimate.productFee}}</text></view>
    <view class="price-row service-fee" wx:if="{{draft.service === '帮买'}}"><text>配送费</text><text>￥{{estimate.deliveryFee}}</text></view>
    <view class="weather-row {{draft.badWeather ? 'active' : ''}}" wx:if="{{estimate.weatherEnabled}}">
      <view>
        <view class="weather-title">天气预报自动判断</view>
        <view class="weather-sub">{{isWeatherLoading ? '正在同步天气预报...' : weatherRisk.reason}}</view>
        <view class="weather-meta">{{weatherRisk.weatherText}}</view>
      </view>
      <view class="weather-badge {{draft.badWeather ? 'bad' : ''}}">{{isWeatherLoading ? '同步中' : (draft.badWeather ? '已触发' : '正常')}}</view>
    </view>
  </view>

  <view class="submit-bar">
    <view class="amount">
      <view class="muted">需支付</view>
      <view class="money">{{estimate.totalText}}</view>
    </view>
    <button class="pay-btn" disabled="{{isSubmitting || !pricingReady}}" bindtap="submitOrder">{{isSubmitting ? '处理中...' : (pricingReady ? '微信支付并下单' : '同步价格中...')}}</button>
  </view>
</view>
