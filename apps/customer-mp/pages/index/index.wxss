.home-page {
  min-height: 100vh;
  padding-bottom: 28rpx;
  background:
    radial-gradient(circle at 92% 0, rgba(212, 71, 45, 0.12), transparent 240rpx),
    linear-gradient(180deg, #faf6ee 0%, #f4f0e8 48%, #f4f0e8 100%);
}

.topbar {
  height: 108rpx;
  padding: 14rpx 28rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.brand-seal {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 auto;
  border-radius: 17rpx 17rpx 17rpx 5rpx;
  color: #fffaf2;
  background: linear-gradient(145deg, var(--cinnabar), var(--cinnabar-strong));
  box-shadow: 0 8rpx 20rpx rgba(185, 47, 32, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  font-weight: 900;
}

.brand-lockup > view:last-child {
  min-width: 0;
}

.brand {
  max-width: 430rpx;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
  white-space: nowrap;
}

.brand-caption {
  margin-top: 3rpx;
  color: #8d887f;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.city-chip {
  height: 48rpx;
  max-width: 142rpx;
  padding: 0 14rpx;
  flex: 0 0 auto;
  border: 2rpx solid rgba(24, 32, 29, 0.08);
  border-radius: 25rpx;
  color: #3a423d;
  background: rgba(255, 253, 248, 0.86);
  box-shadow: 0 7rpx 18rpx rgba(49, 39, 25, 0.05);
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  font-weight: 750;
}

.city-chip text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-dot {
  width: 11rpx;
  height: 11rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--jade);
  box-shadow: 0 0 0 6rpx rgba(40, 116, 92, 0.1);
}

.hero-card {
  height: 242rpx;
  margin: 0 28rpx;
  padding: 29rpx 28rpx;
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  color: #fffaf0;
  background:
    radial-gradient(circle at 85% 12%, rgba(222, 150, 84, 0.38), transparent 170rpx),
    linear-gradient(130deg, #1c2722 0%, #25392f 56%, #463624 100%);
  box-shadow: 0 18rpx 44rpx rgba(34, 40, 34, 0.15);
  animation: hero-reveal 360ms var(--ease-out) both;
}

.hero-card::after {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0.13;
  background-image: radial-gradient(rgba(255, 255, 255, 0.72) 1rpx, transparent 1rpx);
  background-size: 19rpx 19rpx;
  pointer-events: none;
}

.hero-copy {
  width: 60%;
  position: relative;
  z-index: 2;
}

.hero-kicker {
  color: #e9b66f;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 12rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.24;
  letter-spacing: -1rpx;
}

.hero-meta {
  margin-top: 17rpx;
  display: flex;
  align-items: center;
  gap: 11rpx;
  color: rgba(255, 250, 240, 0.68);
  font-size: 18rpx;
}

.hero-meta text {
  color: #f2c17c;
  font-size: 22rpx;
  font-weight: 900;
}

.meta-divider {
  width: 2rpx;
  height: 18rpx;
  background: rgba(255, 255, 255, 0.22);
}

.route-art {
  width: 224rpx;
  height: 224rpx;
  position: absolute;
  right: -12rpx;
  bottom: -12rpx;
  z-index: 1;
  opacity: 0.9;
}

.route-orbit {
  position: absolute;
  border: 2rpx solid rgba(247, 196, 126, 0.23);
  border-radius: 50%;
}

.orbit-a {
  width: 214rpx;
  height: 112rpx;
  top: 57rpx;
  left: 4rpx;
  transform: rotate(-18deg);
}

.orbit-b {
  width: 180rpx;
  height: 87rpx;
  top: 87rpx;
  left: 26rpx;
  transform: rotate(24deg);
}

.route-node {
  width: 48rpx;
  height: 48rpx;
  position: absolute;
  z-index: 2;
  border: 5rpx solid rgba(255, 253, 248, 0.88);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", serif;
  font-size: 18rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.2);
}

.node-a {
  left: 22rpx;
  top: 111rpx;
  color: #fff;
  background: var(--cinnabar);
}

.node-b {
  right: 13rpx;
  top: 54rpx;
  color: #173025;
  background: #e9b66f;
}

.route-rider {
  position: absolute;
  top: 102rpx;
  left: 105rpx;
  color: #f2c17c;
  font-size: 36rpx;
  transform: rotate(-18deg);
}

.locate {
  position: absolute;
  right: 18rpx;
  bottom: 16rpx;
  z-index: 3;
  width: 50rpx;
  height: 50rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 16rpx;
  color: #fffaf0;
  background: rgba(16, 25, 21, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  transition: transform 140ms var(--ease-out), background-color 140ms ease;
}

.order-panel {
  position: relative;
  margin: 16rpx 28rpx 0;
  padding: 24rpx 22rpx 20rpx;
  border: 2rpx solid rgba(24, 32, 29, 0.07);
  border-radius: 27rpx;
  background: var(--paper);
  box-shadow: 0 16rpx 40rpx rgba(48, 39, 27, 0.07);
  animation: panel-reveal 380ms 40ms var(--ease-out) both;
}

.panel-head {
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-kicker {
  margin-bottom: 5rpx;
  color: var(--cinnabar);
  font-size: 18rpx;
  font-weight: 850;
  letter-spacing: 3rpx;
}

.panel-title {
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
  font-size: 35rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.vehicle-pill {
  min-height: 40rpx;
  max-width: 150rpx;
  padding: 0 12rpx;
  border: 2rpx solid rgba(212, 71, 45, 0.15);
  border-radius: 21rpx;
  color: #a93425;
  background: #fff2e8;
  display: flex;
  align-items: center;
  font-size: 17rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.core-task-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9rpx;
}

.task-card {
  transition: transform 140ms var(--ease-out), border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
}

.core-task {
  min-height: 139rpx;
  padding: 14rpx 5rpx 12rpx;
  position: relative;
  border: 2rpx solid rgba(24, 32, 29, 0.08);
  border-radius: 18rpx;
  background: #fbf8f2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
}

.core-task.active {
  border-color: rgba(212, 71, 45, 0.45);
  background: #fff3e9;
  box-shadow: 0 9rpx 20rpx rgba(161, 62, 40, 0.08);
}

.task-icon {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 auto;
  border-radius: 16rpx;
  background: #fffdf9;
  box-shadow: inset 0 0 0 2rpx rgba(24, 32, 29, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
}

.core-task.active .task-icon {
  box-shadow: inset 0 0 0 2rpx rgba(212, 71, 45, 0.14);
}

.task-copy {
  min-width: 0;
  max-width: 100%;
  text-align: center;
}

.task-name {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 850;
  white-space: nowrap;
}

.task-desc {
  margin-top: 4rpx;
  max-width: 100%;
  color: #888278;
  font-size: 17rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-check {
  width: 24rpx;
  height: 24rpx;
  position: absolute;
  top: 7rpx;
  right: 7rpx;
  border-radius: 50%;
  color: #fff;
  background: var(--cinnabar);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  font-weight: 900;
  opacity: 0;
  transform: scale(0.95);
  transition: opacity 140ms ease, transform 140ms var(--ease-out);
}

.core-task.active .task-check {
  opacity: 1;
  transform: scale(1);
}

.more-head {
  margin: 18rpx 0 10rpx;
  display: flex;
  align-items: center;
  gap: 11rpx;
}

.more-title {
  color: #837e74;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.more-line {
  height: 2rpx;
  flex: 1;
  background: rgba(24, 32, 29, 0.08);
}

.more-task-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 7rpx;
}

.more-task {
  min-width: 0;
  min-height: 116rpx;
  padding: 13rpx 1rpx 11rpx;
  border: 2rpx solid rgba(24, 32, 29, 0.07);
  border-radius: 17rpx;
  color: #606862;
  background: #fbf8f2;
  text-align: center;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 5rpx 14rpx rgba(48, 39, 27, 0.035);
  transition: transform 140ms var(--ease-out), color 140ms ease, border-color 140ms ease, background-color 140ms ease;
}

.more-task.active {
  color: var(--cinnabar-strong);
  border-color: rgba(212, 71, 45, 0.35);
  background: #fff3e9;
  box-shadow: 0 8rpx 18rpx rgba(161, 62, 40, 0.07);
}

.more-icon {
  width: 50rpx;
  height: 50rpx;
  margin: 0;
  border-radius: 15rpx;
  background: #fffdf9;
  box-shadow: inset 0 0 0 2rpx rgba(24, 32, 29, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
}

.more-task.active .more-icon {
  background: #fffaf3;
  box-shadow: inset 0 0 0 2rpx rgba(212, 71, 45, 0.14);
}

.service-detail-stage {
  position: relative;
  min-height: 0;
}

.service-change-mask {
  position: absolute;
  z-index: 5;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 21rpx;
  background: rgba(255, 253, 248, 0.96);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.service-change-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid rgba(212, 71, 45, 0.16);
  border-top-color: var(--cinnabar);
  border-radius: 50%;
  animation: service-change-spin 680ms linear infinite;
}

.service-change-text {
  margin-top: 12rpx;
  color: #8d8981;
  font-size: 20rpx;
}

.price-strip {
  min-height: 78rpx;
  margin: 16rpx 0 12rpx;
  padding: 12rpx 14rpx;
  border: 2rpx solid rgba(212, 71, 45, 0.13);
  border-radius: 18rpx;
  background: linear-gradient(100deg, #fff2e7, #fffaf3);
  display: flex;
  align-items: center;
  gap: 11rpx;
  transition: transform 140ms var(--ease-out), border-color 140ms ease, background-color 140ms ease;
}

.price-strip-manual {
  border-color: rgba(40, 116, 92, 0.18);
  background: linear-gradient(100deg, #edf7f1, #f8fcf8);
}

.price-tag {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
  border-radius: 13rpx;
  color: #fff;
  background: var(--cinnabar);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "DIN Alternate", sans-serif;
  font-size: 21rpx;
  font-weight: 900;
}

.price-strip-manual .price-tag {
  background: var(--jade);
}

.price-main {
  min-width: 0;
  flex: 1;
}

.price-title {
  color: #2b302d;
  font-size: 22rpx;
  font-weight: 850;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-sub {
  margin-top: 4rpx;
  color: #8d877e;
  font-size: 17rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-arrow {
  color: var(--cinnabar);
  font-size: 31rpx;
  line-height: 1;
}

.price-strip-manual .price-arrow {
  color: var(--jade);
}

.route-entry-tip,
.handling-home-tip {
  margin-top: 12rpx;
  padding: 11rpx 14rpx;
  border-radius: 14rpx;
  color: #426057;
  background: #edf7f1;
  font-size: 18rpx;
  line-height: 1.45;
}

.handling-home-tip {
  color: #7f633c;
  background: #fff4dc;
}

.route-entry-tip text,
.handling-home-tip text {
  font-weight: 850;
}

.route-entry-tip text {
  color: #214f40;
}

.handling-home-tip text {
  color: #513f28;
}

.route-group {
  padding: 2rpx 14rpx;
  border: 2rpx solid rgba(24, 32, 29, 0.09);
  border-radius: 20rpx;
  background: #fffefa;
  display: flex;
  gap: 10rpx;
}

.route-rail {
  width: 20rpx;
  padding: 27rpx 0;
  display: flex;
  align-items: center;
  flex-direction: column;
}

.rail-dot {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 auto;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx currentColor;
}

.rail-dot.start {
  color: var(--cinnabar);
  background: var(--cinnabar);
}

.rail-dot.end {
  color: var(--jade);
  background: var(--jade);
}

.rail-line {
  width: 2rpx;
  min-height: 58rpx;
  flex: 1;
  margin: 6rpx 0;
  background: repeating-linear-gradient(to bottom, rgba(24, 32, 29, 0.24) 0, rgba(24, 32, 29, 0.24) 5rpx, transparent 5rpx, transparent 10rpx);
}

.route-fields {
  min-width: 0;
  flex: 1;
}

.route-row {
  min-height: 86rpx;
  padding: 13rpx 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  transition: transform 140ms var(--ease-out), opacity 140ms ease;
}

.route-main {
  min-width: 0;
  flex: 1;
}

.route-label {
  margin-bottom: 4rpx;
  color: #999287;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.route-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 850;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-title.placeholder {
  color: #7c7f79;
}

.route-sub {
  margin-top: 4rpx;
  color: #908a81;
  font-size: 17rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-separator {
  height: 2rpx;
  background: rgba(24, 32, 29, 0.08);
}

.address-book-btn {
  padding: 7rpx 10rpx;
  border-radius: 11rpx;
  color: #656a65;
  background: #f2eee6;
  font-size: 16rpx;
  font-weight: 750;
  white-space: nowrap;
}

.order-btn {
  position: relative;
  width: 100%;
  height: 78rpx;
  box-sizing: border-box;
  margin-top: 17rpx;
  padding: 0 76rpx;
  border-radius: 42rpx;
  justify-content: center;
  flex-wrap: nowrap;
  white-space: nowrap;
  font-size: 27rpx;
}

.order-btn-label {
  display: inline-block;
  flex: 0 0 auto;
  text-align: center;
  white-space: nowrap;
  line-height: 1;
}

.button-arrow {
  position: absolute;
  top: 50%;
  right: 27rpx;
  font-family: "Avenir Next", sans-serif;
  font-size: 34rpx;
  font-weight: 500;
  transform: translateY(-50%);
}

.trust-row {
  margin-top: 12rpx;
  color: #9a958c;
  display: flex;
  justify-content: center;
  gap: 7rpx;
  font-size: 16rpx;
  white-space: nowrap;
}

.task-card:active,
.price-strip:active,
.route-row:active,
.locate:active {
  transform: scale(0.975);
}

@keyframes service-change-spin {
  to { transform: rotate(360deg); }
}

@keyframes hero-reveal {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes panel-reveal {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-card,
  .order-panel {
    animation: none;
  }

  .task-card,
  .price-strip,
  .route-row,
  .locate {
    transition: opacity 120ms ease;
  }

  .task-card:active,
  .price-strip:active,
  .route-row:active,
  .locate:active {
    transform: none;
  }
}
