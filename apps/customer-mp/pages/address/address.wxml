<view class="address-page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="page-nav">
    <view class="back floating-back" style="top: {{statusBarHeight + 12}}px;" bindtap="goBack" role="button" aria-label="返回">‹</view>
    <view class="nav-copy"><view class="nav-title">{{title}}</view><view class="nav-subtitle">{{isCarpool ? routeName + ' · 选择地点' : '选择一个地址继续'}}</view></view>
    <view class="nav-space"></view>
  </view>

  <view class="quick-panel" wx:if="{{frequentAddresses.length && !keyword}}">
    <view class="quick-head"><view><view class="eyebrow">常用地点</view><view class="quick-title">你常去的</view></view><view class="quick-count">{{frequentAddresses.length}} 个</view></view>
    <scroll-view class="frequent-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="frequent-track">
        <block wx:for="{{frequentAddresses}}" wx:key="id">
          <view class="frequent-card" data-id="{{item.id}}" bindtap="chooseAddress">
            <view class="frequent-card-top"><view class="pin frequent">常</view><view class="frequent-distance">{{item.distance}}</view></view>
            <view class="frequent-name">{{item.name}}</view>
            <view class="frequent-detail">{{item.detail}}</view>
            <view class="frequent-badge" wx:if="{{item.isDefault}}">默认</view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="search-card">
    <text class="search-icon">⌕</text>
    <input placeholder="搜索小区、写字楼、门店" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    <view class="search-locate" role="button" aria-label="定位当前位置" bindtap="locateCurrent"><view class="search-locate-icon">⌖</view><view>{{isLocating ? '定位中' : '当前位置'}}</view></view>
  </view>

  <view class="map-picker-card" role="button" aria-label="打开地图选点" bindtap="openMapPicker">
    <view class="map-picker-visual"><view class="map-picker-icon"><view class="map-picker-dot"></view></view></view>
    <view class="location-copy"><view class="location-title">地图选点</view><view class="location-sub">拖动地图上的红色图钉，精确选择位置</view></view>
    <view class="map-picker-action">打开</view>
  </view>

  <view class="current-card" wx:if="{{currentAddress && !isCarpool}}" bindtap="chooseCurrent">
    <view class="current-icon">⌖</view>
    <view class="current-copy"><view class="current-label">当前位置</view><view class="current-name">{{currentAddress.name}}</view><view class="current-detail">{{currentAddress.detail}}</view></view>
    <view class="current-use">使用 <text>›</text></view>
  </view>

  <view class="list-header">
    <view><view class="list-title">{{keyword ? '搜索结果' : (isCarpool ? routeName + '地址推荐' : '我的地址')}}</view><view class="list-caption" wx:if="{{isSearching}}">正在搜索…</view><view class="list-caption" wx:elif="{{keyword}}">选择后可继续填写</view></view>
    <view class="list-count" wx:if="{{!keyword && !isCarpool}}">{{myAddresses.length}} / 10</view>
  </view>

  <view class="address-list">
    <block wx:for="{{addresses}}" wx:key="id">
      <view class="address-item {{item.isMapResult ? 'map-result' : ''}}" data-id="{{item.id}}" bindtap="chooseAddress">
        <view class="pin {{item.isMapResult ? 'map' : pinClass}}">{{item.isMapResult ? '搜' : pinLabel}}</view>
        <view class="info"><view class="name">{{item.name}} <text>{{item.distance}}</text><text wx:if="{{item.isDefault}}" class="default-badge">默认</text></view><view class="detail">{{item.detail}}</view><view class="person"><text wx:if="{{item.sourceLabel && item.isMapResult}}">{{item.sourceLabel}} · </text>{{item.contact}} {{item.phone}}</view></view>
        <view class="use-map" wx:if="{{item.isMapResult}}">使用 <text>›</text></view>
        <view class="item-actions" wx:else><view class="edit" data-id="{{item.id}}" catchtap="editAddress">编辑</view><view class="delete" data-id="{{item.id}}" catchtap="deleteAddress">删除</view></view>
      </view>
    </block>
  </view>

  <view class="empty-card" wx:if="{{!addresses.length && !isSearching}}"><view class="empty-icon">＋</view><view class="empty-title">还没有保存的地址</view><view class="empty-sub">新增一个地址，下次可以直接使用</view></view>

  <view class="add-address-bottom" role="button" aria-label="手动填写地址" bindtap="addAddress">
    <view class="add-address-surface">
      <view class="add-address-icon" aria-hidden="true"><text>＋</text></view>
      <view class="add-address-copy">
        <text class="add-address-label">新增地址</text>
        <text class="add-address-hint">手动填写联系人与位置</text>
      </view>
      <view class="add-address-arrow" aria-hidden="true">›</view>
    </view>
  </view>
</view>
