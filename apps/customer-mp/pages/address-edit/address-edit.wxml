<view class="edit-page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="page-nav">
    <view class="back floating-back" style="top: {{statusBarHeight + 12}}px;" bindtap="goBack" role="button" aria-label="返回">‹</view>
    <view class="nav-center">
      <view class="nav-title">{{title}}</view>
      <view class="nav-caption">{{selectAfterSave ? '订单地址' : '地址簿'}}</view>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="compact-heading"><view class="eyebrow">{{selectAfterSave ? '订单地址' : '地址簿'}}</view><view class="compact-title">填写地址信息</view></view>

  <view class="smart-card {{recognizing ? 'is-recognizing' : ''}}">
    <view class="smart-head">
      <view class="smart-icon">✦</view>
      <view class="smart-copy">
        <view class="smart-title">智能识别</view>
        <view class="smart-sub">粘贴姓名、电话和地址，自动填入表单</view>
      </view>
      <button class="smart-head-action {{smartPasteText ? 'ready' : ''}}" bindtap="smartRecognize" loading="{{recognizing}}" disabled="{{recognizing}}"><text>{{recognizing ? '识别中' : '识别'}}</text><text class="smart-action-arrow">→</text></button>
    </view>
    <view class="smart-input-row">
      <view class="smart-input-wrap {{smartPasteText ? 'has-text' : ''}}">
        <textarea class="smart-input" value="{{smartPasteText}}" bindinput="inputSmartPaste" maxlength="300" auto-height placeholder="例如：张三 13800138000 福鼎市..." />
        <view class="smart-input-meta"><text>仅用于本页填写，不会提交原文</text><text>{{smartPasteText ? '已输入' : '等待粘贴'}}</text></view>
      </view>
    </view>
    <view wx:if="{{smartPreview}}" class="smart-preview">
      <view class="smart-result-icon success">✓</view>
      <view class="smart-result-copy"><view class="smart-preview-title">{{smartPreview.complete ? '已识别并填入' : '已识别部分信息'}}</view><view class="smart-preview-sub">{{smartPreview.complete ? (smartPreview.contact || '联系人待补充') + ' · ' + (smartPreview.phone || '手机号待补充') : '还需补充：' + smartPreview.missingText}}</view><view class="smart-preview-sub">{{smartPreview.name || '地址待补充'}} {{smartPreview.address || ''}}</view></view>
      <view class="smart-result-chevron">›</view>
    </view>
    <view wx:elif="{{smartResult}}" class="smart-result warning"><view class="smart-result-icon">!</view><view class="smart-result-copy"><view class="smart-preview-title">需要再看一眼</view><view class="smart-preview-sub">{{smartResult}}</view></view></view>
  </view>

  <view class="section-heading">
    <view><view class="section-kicker">地址信息</view><view class="section-title">收发货地点</view></view>
    <view class="section-note"><text>*</text> 必填</view>
  </view>

  <view class="form-card">
    <view class="scope-lock" wx:if="{{isCarpool}}"><text class="scope-dot">●</text> 已锁定 {{routeName}}线 · {{form.city}}{{form.district}}</view>

    <view class="field-row address-row">
      <view class="field-meta"><view class="label">地址 <text>*</text></view></view>
      <input class="field-input" value="{{mapKeyword}}" placeholder="输入地点名称" bindinput="inputMapKeyword" confirm-type="search" />
      <view class="locate-inline" bindtap="useCurrentLocation"><text class="locate-icon">⌖</text><text>{{isLocating ? '定位中' : '定位'}}</text></view>
    </view>

    <view class="map-loading" wx:if="{{isSearching}}"><text class="loading-dot">●</text> 正在搜索地址…</view>
    <view class="map-results" wx:if="{{mapResults.length}}">
      <block wx:for="{{mapResults}}" wx:key="id">
        <view class="map-result" data-id="{{item.id}}" bindtap="chooseMapResult">
          <view class="map-pin">⌖</view>
          <view class="map-info"><view class="map-name">{{item.name}} <text>{{item.distance}}</text></view><view class="map-detail">{{item.detail}}</view></view>
          <view class="map-use">选择 <text>›</text></view>
        </view>
      </block>
    </view>

    <view class="field-row">
      <view class="field-meta"><view class="label">门牌号 <text>*</text></view></view>
      <input class="field-input" value="{{form.detail}}" placeholder="例如：2栋1单元302" data-field="detail" bindinput="inputField" />
    </view>

    <view class="field-row" wx:if="{{requiresContact}}">
      <view class="field-meta"><view class="label">手机号 <text>*</text></view></view>
      <input class="field-input" value="{{form.phone}}" placeholder="11位手机号" type="number" maxlength="11" data-field="phone" bindinput="inputField" />
    </view>

    <view class="field-row" wx:if="{{requiresContact}}">
      <view class="field-meta"><view class="label">联系人 <text>*</text></view></view>
      <input class="field-input" value="{{form.contact}}" placeholder="请输入姓名" data-field="contact" bindinput="inputField" />
    </view>

    <view class="tag-section">
      <view class="tag-label">地址标签 <text>可选</text></view>
      <view class="tags"><block wx:for="{{tags}}" wx:key="*this"><view class="tag {{form.tag === item ? 'active' : ''}}" data-tag="{{item}}" bindtap="selectTag">{{item}}</view></block></view>
    </view>

    <view class="default-row" role="checkbox" aria-checked="{{form.isDefault}}" bindtap="toggleDefault">
      <view class="check {{form.isDefault ? 'on' : ''}}">{{form.isDefault ? '✓' : ''}}</view>
      <view class="default-copy"><view class="default-title">设为默认地址</view><view class="default-sub">下次填写时优先使用</view></view>
      <view class="row-chevron">›</view>
    </view>

    <view class="coordinate-row" wx:if="{{form.latitude && form.longitude}}"><text>✓</text> 已关联地图位置</view>
  </view>

  <view class="save-address-row {{saveToAddressBook ? 'is-selected' : ''}}" wx:if="{{selectAfterSave && !form.id}}" role="checkbox" aria-checked="{{saveToAddressBook}}" bindtap="toggleSaveToAddressBook">
    <view class="save-option-icon">{{saveToAddressBook ? '✓' : '＋'}}</view>
    <view class="save-copy"><view class="save-title">保存到我的地址</view><view class="save-sub">{{saveToAddressBook ? '下次可直接使用这组联系人和位置' : '只用于本次订单，不会写入地址簿'}}</view></view>
    <view class="save-toggle"><view class="save-toggle-thumb"></view></view>
  </view>

  <view class="bottom-action">
    <view class="action-copy"><view class="action-title">{{selectAfterSave && !saveToAddressBook ? '仅用于本次订单' : '确认后即可使用'}}</view><view class="action-sub">地址信息将受到保护</view></view>
    <button class="save-btn" bindtap="submit">{{selectAfterSave && !saveToAddressBook ? '使用此地址' : '确认保存'}}</button>
  </view>
</view>
