page {
  min-height: 100%;
  color: #172033;
  background: #f6f7f9;
  font-family: "PingFang SC", "Hiragino Sans GB", sans-serif;
  --ink: #172033;
  --muted: #778298;
  --line: #e8ecf1;
  --paper: #fff;
  --blue: #183a56;
  --teal: #147f78;
  --mint: #5ce2bd;
  --coral: #f0643b;
  --coral-dark: #e4472c;
  --ease-out: cubic-bezier(.2, .8, .2, 1);
}

view, text, button, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; border-radius: 0; line-height: 1.2; background: transparent; transition: transform 140ms var(--ease-out), opacity 140ms ease, box-shadow 140ms ease; }
button::after { border: 0; }

.page { position: relative; min-height: 100vh; overflow: hidden; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); background: radial-gradient(circle at 96% 1%, rgba(92, 226, 189, .13), transparent 300rpx), linear-gradient(180deg, #f1f7f7 0, #f6f7f9 470rpx, #f6f7f9 100%); }
.ambient { position: absolute; z-index: 0; border-radius: 50%; pointer-events: none; filter: blur(2rpx); opacity: .7; }.ambient-one { width: 300rpx; height: 300rpx; top: 142rpx; right: -174rpx; background: rgba(92, 226, 189, .12); }.ambient-two { width: 240rpx; height: 240rpx; top: 790rpx; left: -170rpx; background: rgba(240, 100, 59, .06); }
.topbar { position: relative; z-index: 2; display: flex; align-items: center; padding-right: 30rpx; padding-left: 18rpx; background: rgba(246, 247, 249, .76); backdrop-filter: blur(22rpx) saturate(130%); }.back { position: absolute; z-index: 3; left: 10rpx; display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; color: var(--ink); background: transparent; font-size: 38rpx; font-weight: 300; line-height: 56rpx; }.back text { display: block; transform: translateY(-1rpx); }.back-pressed { opacity: .5; transform: scale(.9); }.nav-copy { position: absolute; z-index: 0; left: 0; right: 0; text-align: center; pointer-events: none; }.nav-kicker { display: block; color: #8a94a5; font-size: 19rpx; font-weight: 800; letter-spacing: 2rpx; }.title { display: block; margin-top: 5rpx; color: var(--ink); font-size: 34rpx; font-weight: 900; letter-spacing: -.5rpx; }.nav-spacer { width: 72rpx; }.content { position: relative; z-index: 1; padding: 14rpx 30rpx 0; }

.loading-card { position: relative; z-index: 1; display: flex; align-items: center; gap: 22rpx; margin: 26rpx 30rpx 0; padding: 34rpx; border: 2rpx solid rgba(232, 236, 241, .8); border-radius: 28rpx; background: rgba(255, 255, 255, .86); box-shadow: 0 18rpx 48rpx rgba(24, 35, 54, .05); }.loading-icon { width: 58rpx; height: 58rpx; border: 5rpx solid #e8edf1; border-top-color: var(--teal); border-radius: 50%; animation: spin 900ms linear infinite; }.loading-copy { flex: 1; }.loading-line { height: 20rpx; margin-top: 14rpx; border-radius: 10rpx; background: #edf0f3; }.loading-line.short { width: 34%; margin-top: 0; height: 16rpx; }@keyframes spin { to { transform: rotate(360deg); } }

.hero-card { position: relative; overflow: hidden; padding: 38rpx 34rpx 30rpx; border-radius: 32rpx; color: #fff; background: linear-gradient(132deg, #162d48 0%, #145468 54%, #13847d 100%); box-shadow: 0 22rpx 46rpx rgba(20, 65, 82, .2); }.hero-glow { position: absolute; top: -112rpx; right: -76rpx; width: 300rpx; height: 300rpx; border: 2rpx solid rgba(144, 255, 222, .22); border-radius: 50%; box-shadow: 0 0 0 26rpx rgba(144, 255, 222, .06), 0 0 0 56rpx rgba(144, 255, 222, .035); }.hero-topline { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }.eyebrow { color: var(--mint); font-size: 18rpx; font-weight: 900; letter-spacing: 2rpx; }.hero-mark { display: grid; place-items: center; width: 54rpx; height: 54rpx; border: 2rpx solid rgba(255,255,255,.22); border-radius: 18rpx; color: #fff; font-size: 28rpx; font-weight: 900; }.headline { position: relative; z-index: 1; display: block; margin-top: 30rpx; color: #fff; font-size: 46rpx; line-height: 1.15; font-weight: 950; letter-spacing: -1rpx; }.intro-copy { position: relative; z-index: 1; display: block; max-width: 620rpx; margin-top: 18rpx; color: rgba(255,255,255,.74); font-size: 25rpx; line-height: 1.65; }.hero-foot { position: relative; z-index: 1; display: flex; align-items: center; gap: 11rpx; margin-top: 28rpx; padding-top: 22rpx; border-top: 2rpx solid rgba(255,255,255,.15); color: rgba(255,255,255,.86); font-size: 22rpx; font-weight: 700; }.hero-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--mint); box-shadow: 0 0 0 7rpx rgba(92,226,189,.13); }.hero-arrow { margin-left: auto; color: var(--mint); font-size: 30rpx; }

.notice-card { display: flex; align-items: flex-start; gap: 18rpx; margin-top: 20rpx; padding: 24rpx; border: 2rpx solid #ffe0c9; border-radius: 24rpx; background: #fff8f1; }.notice-icon { display: grid; place-items: center; width: 44rpx; height: 44rpx; flex: 0 0 auto; border-radius: 14rpx; color: #b85a2c; background: #ffe3cd; font-size: 26rpx; font-weight: 950; }.notice-body { flex: 1; min-width: 0; }.notice-title, .notice-copy { display: block; }.notice-title { color: #8d4927; font-size: 27rpx; font-weight: 900; }.notice-copy { margin-top: 8rpx; color: #9a765d; font-size: 23rpx; line-height: 1.5; }.text-button { align-self: center; flex: 0 0 auto; color: var(--coral-dark); font-size: 23rpx; font-weight: 900; }.card-pressed, .agreement-pressed { opacity: .72; transform: scale(.985); }

.form-card, .detail-card, .tip-card { margin-top: 20rpx; padding: 30rpx 28rpx; border: 2rpx solid rgba(232,236,241,.9); border-radius: 28rpx; background: rgba(255,255,255,.94); box-shadow: 0 18rpx 48rpx rgba(24,35,54,.055); }.form-heading, .detail-heading { display: flex; align-items: flex-start; justify-content: space-between; }.section-label { display: block; color: var(--ink); font-size: 31rpx; font-weight: 950; letter-spacing: -.4rpx; }.section-note { display: block; margin-top: 7rpx; color: #929aaa; font-size: 21rpx; }.form-step { padding-top: 5rpx; color: #a0a9b6; font-size: 22rpx; font-weight: 800; letter-spacing: 1rpx; }
.field { display: block; position: relative; padding: 25rpx 0 22rpx; border-bottom: 2rpx solid #edf0f4; }.field-label { display: flex; align-items: center; gap: 10rpx; margin-bottom: 12rpx; color: #66738a; font-size: 23rpx; font-weight: 800; }.required { color: #ef7b59; font-size: 19rpx; font-weight: 700; }.field-hint { color: #a3aab5; font-size: 20rpx; font-weight: 500; }.field-input { width: 100%; min-height: 42rpx; color: var(--ink); font-size: 29rpx; font-weight: 600; }.field-placeholder { color: #b1b8c4; font-weight: 400; }.vehicle-field { padding-bottom: 26rpx; }.apply-vehicle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.apply-vehicle { position: relative; display: flex; align-items: center; min-height: 76rpx; gap: 12rpx; padding: 0 14rpx; border: 2rpx solid #e7ebf0; border-radius: 18rpx; color: #66738a; background: #fafbfc; font-size: 24rpx; font-weight: 800; transition: transform 140ms var(--ease-out), border-color 140ms ease, background-color 140ms ease; }.apply-vehicle.selected { border-color: #ff9a7b; color: #c95031; background: #fff3ee; }.vehicle-pressed { transform: scale(.96); }.vehicle-glyph { display: grid; place-items: center; width: 38rpx; height: 38rpx; flex: 0 0 auto; border-radius: 12rpx; color: #75849a; background: #edf1f5; font-size: 20rpx; font-weight: 900; }.selected .vehicle-glyph { color: #fff; background: var(--coral); }.vehicle-name { flex: 1; }.apply-vehicle-check { display: grid; place-items: center; width: 28rpx; height: 28rpx; border: 2rpx solid #d3d9e1; border-radius: 50%; color: #fff; font-size: 17rpx; font-weight: 950; }.apply-vehicle.selected .apply-vehicle-check { border-color: var(--coral); background: var(--coral); }.field-textarea { padding-bottom: 30rpx; }.textarea-input { min-height: 110rpx; line-height: 1.55; font-weight: 400; }.textarea-count { position: absolute; right: 0; bottom: 12rpx; color: #b0b6c0; font-size: 19rpx; }
.agreement { display: flex; align-items: center; gap: 12rpx; min-height: 74rpx; padding: 19rpx 0 8rpx; color: #7d889a; font-size: 22rpx; line-height: 1.4; }.agreement-box { display: grid; place-items: center; width: 34rpx; height: 34rpx; flex: 0 0 auto; border: 2rpx solid #cbd2dc; border-radius: 10rpx; color: #fff; font-size: 23rpx; font-weight: 950; }.agreement-box.checked { border-color: var(--teal); background: var(--teal); }.agreement-link { color: #327b84; font-weight: 700; }.submit-button { display: flex; align-items: center; justify-content: center; gap: 20rpx; width: 100%; height: 88rpx; margin-top: 14rpx; border-radius: 24rpx; color: #fff; background: linear-gradient(110deg, var(--coral), var(--coral-dark)); box-shadow: 0 14rpx 26rpx rgba(228,71,44,.2); font-size: 29rpx; font-weight: 950; }.submit-pressed { opacity: .86; transform: scale(.975); box-shadow: 0 7rpx 14rpx rgba(228,71,44,.14); }.submit-arrow { font-size: 34rpx; font-weight: 400; }.form-footnote { display: block; margin-top: 18rpx; color: #abb2bc; text-align: center; font-size: 19rpx; }

.state-card { margin-top: 10rpx; padding: 48rpx 28rpx 34rpx; text-align: center; border: 2rpx solid rgba(232,236,241,.9); border-radius: 32rpx; background: rgba(255,255,255,.95); box-shadow: 0 20rpx 52rpx rgba(24,35,54,.07); }.state-icon { position: relative; display: grid; place-items: center; width: 104rpx; height: 104rpx; margin: 0 auto 24rpx; border-radius: 32rpx; color: #fff; font-size: 47rpx; font-weight: 900; }.pending-icon { overflow: hidden; background: #f2ad3d; }.pending-orbit { position: absolute; width: 150rpx; height: 150rpx; border: 2rpx solid rgba(255,255,255,.28); border-radius: 50%; transform: translate(32rpx,-40rpx); }.active-icon { background: #18a66a; box-shadow: 0 14rpx 24rpx rgba(24,166,106,.2); }.blocked-icon { background: #8d97a7; }.state-kicker { display: block; color: #a4acb8; font-size: 18rpx; font-weight: 900; letter-spacing: 2rpx; }.state-title { display: block; margin-top: 12rpx; color: var(--ink); font-size: 38rpx; font-weight: 950; letter-spacing: -1rpx; }.state-copy { display: block; margin: 17rpx auto 0; max-width: 600rpx; color: #7b879a; font-size: 25rpx; line-height: 1.65; }.state-card .submit-button { margin-top: 30rpx; }.status-steps { display: flex; align-items: flex-start; margin-top: 38rpx; padding: 0 10rpx; }.status-step { display: flex; flex-direction: column; align-items: center; gap: 10rpx; color: #a1aab7; font-size: 20rpx; white-space: nowrap; }.status-step.done, .status-step.current { color: #3b7f7c; font-weight: 800; }.step-dot { display: grid; place-items: center; width: 38rpx; height: 38rpx; border: 2rpx solid #d9dfe6; border-radius: 50%; color: #a7afbb; font-size: 18rpx; }.done .step-dot { border-color: var(--teal); color: #fff; background: var(--teal); }.current .step-dot { border-color: #e8a143; color: #fff; background: #e8a143; }.step-line { flex: 1; height: 2rpx; margin: 18rpx 8rpx 0; background: #e6eaf0; }.step-line.active { background: #79bcb2; }.detail-card { margin-top: 20rpx; }.detail-badge { padding: 7rpx 14rpx; border-radius: 20rpx; color: #a26a1e; background: #fff4da; font-size: 19rpx; font-weight: 800; }.detail-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-top: 2rpx solid #edf0f4; color: #8993a2; font-size: 24rpx; }.detail-row:first-of-type { margin-top: 22rpx; }.detail-row text:last-child { color: var(--ink); font-weight: 800; text-align: right; }.tip-card { display: flex; align-items: center; gap: 14rpx; color: #778599; font-size: 22rpx; line-height: 1.45; }.tip-icon { display: grid; place-items: center; width: 34rpx; height: 34rpx; flex: 0 0 auto; border-radius: 50%; color: #fff; background: #6ca8a3; font-size: 21rpx; font-weight: 900; }

@media (prefers-reduced-motion: reduce) { button, .apply-vehicle, .loading-icon { transition: opacity 120ms ease; animation: none; }.back-pressed, .card-pressed, .agreement-pressed, .vehicle-pressed, .submit-pressed { transform: none; } }
@media (prefers-reduced-transparency: reduce) { .topbar { background: #f6f7f9; backdrop-filter: none; }.form-card, .detail-card, .tip-card { background: #fff; } }
@media (prefers-contrast: more) { .form-card, .detail-card, .tip-card, .state-card { border-color: #8d98a8; }.field { border-bottom-color: #aeb7c3; } }
